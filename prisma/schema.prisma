generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  nombre       String
  cedula       String   @unique
  rol          Rol      @default(CLIENTE)
  createdAt    DateTime @default(now())
  boletos      Boleto[]
  vendidosChofer Boleto[] @relation("VendidoPorChofer")
}

model Bus {
  id          String   @id @default(cuid())
  numero      String   @unique
  placa       String   @unique
  chasis      String
  carroceria  String
  marca       String
  fotoUrl     String?
  capacidad   Int
  asientosVIP Int      @default(0)
  activo      Boolean  @default(true)
  rutas       Ruta[]
}

model Frecuencia {
  id         String   @id @default(cuid())
  origen     String
  destino    String
  hora       String
  tipoViaje  TipoViaje @default(DIRECTO)
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now())
  paradas    ParadaFrecuencia[]
  rutas      Ruta[]
}

model ParadaFrecuencia {
  id           String   @id @default(cuid())
  frecuenciaId String
  ciudad       String
  orden        Int
  frecuencia   Frecuencia @relation(fields: [frecuenciaId], references: [id])
}

model Ruta {
  id          String   @id @default(cuid())
  frecuenciaId String
  fecha       DateTime
  busId       String
  completada  Boolean  @default(false)
  frecuencia  Frecuencia @relation(fields: [frecuenciaId], references: [id])
  bus         Bus       @relation(fields: [busId], references: [id])
  boletos     Boleto[]
}

model Boleto {
  id                String        @id @default(cuid())
  rutaId            String
  pasajeroId        String
  asiento           String
  precio            Float
  descuento         Float         @default(0)
  tipoPasajero      TipoPasajero
  metodoPago        MetodoPago
  comprobanteUrl    String?
  estado            EstadoBoleto  @default(PENDIENTE_APROBACION)
  qrUrl             String?
  vendidoPor        String?
  vendidoPorChoferId String?
  createdAt         DateTime      @default(now())
  ruta              Ruta          @relation(fields: [rutaId], references: [id])
  pasajero          Usuario       @relation(fields: [pasajeroId], references: [id])
  vendidoPorChofer  Usuario?      @relation("VendidoPorChofer", fields: [vendidoPorChoferId], references: [id])
}

enum Rol {
  ADMIN
  OFICINISTA
  CHOFER
  CLIENTE
}

enum TipoViaje {
  DIRECTO
  CON_PARADAS
}

enum TipoPasajero {
  ADULTO
  NINO
  TERCERA_EDAD
  DISCAPACITADO
}

enum MetodoPago {
  TRANSFERENCIA
  EFECTIVO
  TARJETA
  PAYPAL
}

enum EstadoBoleto {
  PENDIENTE_APROBACION
  APROBADO
  ABORDADO
  CANCELADO
}